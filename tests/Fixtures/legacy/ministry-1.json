    {
        "name": "Ministry 1 General Section Philosophy 1",
        "slug": "ministry-1-general-section-philosophy-1",
        "template": "trix-text",
        "data": {},
        "extras": {
            "title_1": {
                "en": "TEACHING METHODOLOGY"
            },
            "content_1": {
                "en": "The Cachorros program has the following goals:<ul><li>to ensure children learn the requirements in an age-appropriate manner, by playing, interacting and using their five senses;</li><li>to provide opportunities for interaction with other children, fostering team work and a sense of community;</li><li>to make sure that children learn and practice the value of caring and sharing and of being organized;</li><li>to help children improve their self-esteem as they see they are capable of doing an activity on their own;</li><li>to teach children to ask for help when they need it.</li></ul>"
            }
        }
    },
    {
        "name": "Ministry 1 General Section Philosophy 2",
        "slug": "ministry-1-general-section-philosophy-2",
        "template": "trix-text",
        "data": {},
        "extras": {
            "title_1": {
                "en": "Teaching Methodology"
            },
            "content_1": {
                "en": "That children learn the requirements in accordance with their age: playing, interacting and using their five senses;<br><ul><li>that children interact with one another, fostering team work;</li><li>that children learn and put into practice the value of “sharing”;</li><li>that children learn to wait for their turn and to be organized;</li><li>that children improve their self-esteem as they see they are capable of doing an activity on their own;</li><li>that children learn to ask for help when they really need it.</li></ul>"
            }
        }
